# Copie este arquivo para .env e ajuste os valores para o seu ambiente local.
# O .env é lido automaticamente tanto pela aplicacao (via spring-dotenv, na
# raiz do projeto) quanto pelo docker compose. Nunca commite o .env real —
# ele ja esta no .gitignore.

# --- Banco de dados ---
DB_URL=jdbc:postgresql://localhost:5432/database_local
USER_DB=postgres
PASSWORD_DB=postgres

# --- Servidor ---
PORT=8080
CONTEXT_PATH=/base-url

# --- JWT (obrigatorio, minimo 64 bytes / 512 bits) ---
# Gere um valor com: openssl rand -base64 64 | tr -d '\n'
KEY_JWT_SECRET=
KEY_JWT_EXPIRATION=3600

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# --- Somente para docker compose ---
# Porta exposta no host (o container sempre escuta na 8080 internamente)
APP_HOST_PORT=8080
# Habilita as migrations do Flyway ao subir via Docker
SPRING_FLYWAY_ENABLED=true
